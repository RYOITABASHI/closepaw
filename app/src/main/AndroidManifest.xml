<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Shizuku permission for virtual display operations -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Shelly background runs: status / approval / "don't open <app>" notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- MCP degraded mode: declarations only; each takes effect after an adb pm grant -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.READ_LOGS" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Package visibility: Allow querying launchable apps and Termux RUN_COMMAND (Android 11+) -->
    <queries>
        <package android:name="com.termux" />
        <!-- Shelly trusted-caller verification (PackageManager.hasSigningCertificate) -->
        <package android:name="dev.shelly.terminal" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="com.termux.RUN_COMMAND" />
        </intent>
        <!-- Home launchers: treated as a system surface by the approval policy -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".app.ClosePawApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClosePaw">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.viewer.VirtualDisplayViewerActivity"
            android:theme="@style/Theme.ClosePaw.FullScreen"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <service
            android:name=".app.AgentService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_config" />
        </service>

        <service
            android:name=".app.McpRecoveryService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled local MCP listener and recovery of its Android service dependencies" />
        </service>

        <receiver android:name=".app.McpRecoveryReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Fixed draft routine for a verified Shelly caller. It uses token and sender checks
            and is reachable by explicit component only.
        -->
        <receiver
            android:name=".app.ShellySaveDraftReceiver"
            android:exported="true" />

        <!-- Notification action buttons for Shelly runs (own PendingIntents only). -->
        <receiver
            android:name=".app.ShellyRunActionReceiver"
            android:exported="false" />

        <!-- Result of the self-update PackageInstaller session. -->
        <receiver
            android:name=".update.UpdateInstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ai.closepaw.action.SPIKE_INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Shizuku content provider for binder forwarding -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
